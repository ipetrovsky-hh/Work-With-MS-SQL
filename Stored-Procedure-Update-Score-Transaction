DROP PROCEDURE IF EXISTS ChangeScores;
GO

CREATE PROCEDURE ChangeScores
(
    -- Add the parameters for the stored procedure here
    @NumScore1 INTEGER = NULL,
    @NumScore2 INTEGER = NULL,
    @SummaScoreIN Money = 0
)
AS
BEGIN

    SET NOCOUNT OFF;

    DECLARE @SummaScoreF MONEY;

    SELECT @SummaScoreF = SCORES.SummaScore FROM SCORES WHERE SCORES.NumScore=@NumScore1;
    BEGIN TRANSACTION;
    IF (@SummaScoreF>0)
      BEGIN
       UPDATE SCORES SET SCORES.SummaScore = SCORES.SummaScore + @SummaScoreIN
       WHERE SCORES.NumScore = @NumScore2;    
      END
   COMMIT;
END;
GO

EXECUTE ChangeScores @NumScore1=1, @NumScore2 = 2,@SummaScoreIN=300;

